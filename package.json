{
  "name": "generator-umow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:frontend": "next dev",
    "dev:convex": "convex dev",
    "dev:all": "concurrently --kill-others-on-fail --names frontend,convex --prefix \"[generator-umow:{name}]\" --prefix-colors blue,green \"npm run dev:frontend\" \"npm run dev:convex\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/copy-fonts.js"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.16.3",
    "@expo-google-fonts/source-serif-4": "^0.4.1",
    "@hookform/resolvers": "^3.10.0",
    "@react-pdf/renderer": "^4.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.35.1",
    "lucide-react": "^0.542.0",
    "next": "^16.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.62.0",
    "slownie": "^1.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "^16.3.1",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
